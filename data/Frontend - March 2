<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Beam Comparator Platform</title>
  <style>
    :root {
      --bg: #f5f7fb;
      --panel: #ffffff;
      --ink: #0f172a; /* slate-900 */
      --muted: #64748b; /* slate-500 */
      --brand: #2563eb; /* blue-600 */
      --brand-weak: #e0ecff;
      --ring: #93c5fd; /* blue-300 */
      --card: #f8fafc; /* light */
      --shadow: 0 8px 24px rgba(2,6,23,.06), 0 2px 8px rgba(2,6,23,.04);
      --radius: 16px;
      --ok: #16a34a;
      --bad: #dc2626;
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--ink); background: var(--bg); display: flex; flex-direction: column;
    }
    
    /* Layout */
    aside { width: 280px; background: var(--panel); border-right: 1px solid #e2e8f0; padding: 24px; display: flex; flex-direction: column; flex-direction: column; gap: 12px; }
    main { flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; flex-direction: column; gap: 12px; }

    /* Typography */
    h1, h2, h3 { margin: 0; font-weight: 700; letter-spacing: -0.02em; }
    h1 { font-size: 1.5rem; }
    h2 { font-size: 1.25rem; }
    .muted { color: var(--muted); font-size: 0.875rem; }
    
    /* Cards */
    .card { background: var(--panel); border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid #f1f5f9; }
    .pad { padding: 16px; }
    .stack { display: flex; flex-direction: column; flex-direction: column; gap: 12px; }
    .row { display: flex; flex-direction: column; gap: 12px; align-items: center; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    /* Forms */
    /* CHANGED: Removed 'text-transform: uppercase;' so labels appear as written */
    label { display: block; font-size: 0.75rem; font-weight: 600; color: var(--muted); margin-bottom: 4px; }
    input, select {
      width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; background: #fff; transition: 0.2s;
    }
    input:focus, select:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-weak); }
    
    /* Buttons */
    button {
      cursor: pointer; border: none; font-weight: 600; font-size: 0.9rem; padding: 10px 16px; border-radius: 8px; transition: 0.2s; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-primary { background: var(--brand); color: #fff; width: 100%; }
    .btn-primary:hover { filter: brightness(1.1); }
    .btn-sec { background: #f1f5f9; color: var(--ink); }
    .btn-sec:hover { background: #e2e8f0; }
    .icon-btn { padding: 8px; border-radius: 6px; aspect-ratio: 1; }
    .del-btn { background: #fee2e2; color: var(--bad); padding: 4px 8px; font-size: 12px; margin-left: auto; }

    /* Navigation */
    .nav-btn {
      text-align: left; background: transparent; color: var(--muted); padding: 12px; border-radius: 8px; justify-content: flex-start;
    }
    .nav-btn.active { background: var(--brand-weak); color: var(--brand); }
    
    /* Tabs content */
    .tab-content { display: none; }
    .tab-content.active { display: flex; flex-direction: column; flex-direction: column; gap: 12px; }

    /* Lists */
    ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; flex-direction: column; gap: 8px; }
    li { background: #f8fafc; padding: 8px 12px; border-radius: 6px; font-size: 0.9rem; display: flex; flex-direction: column; align-items: center; border: 1px solid #e2e8f0; }

    /* Charts */
    .chart-box { height: 200px; position: relative; }
    
    /* Utility */
    .badge { padding: 4px 8px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; background: #f1f5f9; }
  
/* ===== Subtle Info Icons ===== */
.label-row { display:flex; align-items:center; gap:6px; }
.info-icon {
  position:relative;
  display:inline-flex;
  width:14px;
  height:14px;
  cursor:pointer;
  opacity:0.75;
}
.info-icon svg {
  width:14px;
  height:14px;
  fill:var(--muted);
}
.tooltip {
  position:absolute;
  top:20px;
  left:0;
  background:#111827;
  color:#fff;
  font-size:0.7rem;
  padding:6px 8px;
  border-radius:6px;
  width:200px;
  opacity:0;
  visibility:hidden;
  transition:0.2s ease;
  z-index:99999;
}
.info-icon:hover .tooltip { opacity:1; visibility:visible; }
/* ============================== */


/* ===== Cleaner Compact Layout ===== */
.row {
  gap: 8px !important;
  flex-wrap: wrap;
}

.row input[type="number"],
.row select {
  flex: 1;
  min-width: 90px;
}

.icon-btn {
  flex: 0 0 auto;
}

.card.pad.stack label {
  margin-top: 4px;
}

h3 { margin-bottom: 6px; }
/* =================================== */


/* ===== Aggressive Spacing Cleanup ===== */

/* Reduce all stack gaps */
.stack { gap: 8px !important; }

/* Reduce grid spacing */
.grid-2 { gap: 10px !important; }

/* Reduce card padding slightly */
.card.pad { padding: 14px !important; }

/* Remove extra margins from labels and headings */
label { margin-bottom: 2px !important; }
h3 { margin-bottom: 4px !important; }

/* Tighten row spacing */
.row { gap: 6px !important; margin-bottom: 4px !important; }

/* Remove extra UL spacing */
ul { gap: 6px !important; margin-top: 4px !important; }

/* Tighten section spacing */
.tab-content { gap: 14px !important; }

/* Remove extra margin-top inline styles */
[style*="margin-top"] { margin-top: 4px !important; }

/* ========================================== */

</style>
</head>
<body>

<header style="background:var(--panel);padding:14px 20px;border-bottom:1px solid #e2e8f0;
display:flex;justify-content:space-between;align-items:center;">
  <div style="display:flex;align-items:center;gap:10px;">
    <div style="width:28px;height:28px;background:conic-gradient(from 210deg, #1e3a8a, #3b82f6, #60a5fa);border-radius:8px;"></div>
    <h1 style="font-size:1.1rem;margin:0;">BeamTool</h1>
  </div>
  <nav style="display:flex;gap:10px;">
    <button class="nav-btn active" onclick="showTab('manual')">Beam Analysis</button>
    <button class="nav-btn" onclick="showTab('compare')">Comparator Engine</button>
  
<button id="aiToggleBtn" class="nav-btn" onclick="toggleAI()">AI Assistant</button>

  
    <button class="nav-btn" onclick="showTab('history')">Design History</button>
    <button class="nav-btn" onclick="showTab('database')">Beam Database</button>
    </nav>
    
</header>


  

  <main>
    
    <div id="manual" class="tab-content active">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h2>Manual Beam Analysis</h2>
        <span id="analysisStatus" class="badge" style="background:#e0f2fe;color:#0369a1">Ready</span>
      </div>

      <div class="grid-2">
        <div class="stack">
          
          <div class="card pad stack">
            <h3>1. Define Beam</h3>
            <div class="grid-2">
              <div>
                
<div class="label-row">
<label>Length (m)</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Beam span length in meters (m).</div>
</div>
</div>

                <input type="number" id="manLength" value="5.0" step="0.1">
              </div>
              <div>
                
<div class="label-row">
<label>Weight (kg/m)</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Self-weight per meter in kilograms per meter (kg/m).</div>
</div>
</div>

                <input type="number" id="manWeight" value="30" step="1" placeholder="Self-weight">
              </div>
            </div>
            <div class="grid-2">
              <div>
                
<div class="label-row">
<label>E (GPa)</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Young's Modulus in gigapascals (GPa).</div>
</div>
</div>

                <input type="number" id="manE" value="200">
              </div>
              <div>
                
<div class="label-row">
<label>I (10⁻⁶ m⁴)</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Second moment of area in 10⁻⁶ m⁴.</div>
</div>
</div>

                <input type="number" id="manI" value="50">
              </div>
            </div>
          </div>

          <div class="card pad stack">
            <h3>2. Loads & Supports</h3>
            
            <div class="row">
              <select id="manSupType" style="flex:1"><option>Pin</option><option>Roller</option><option>Fixed</option></select>
              <input type="number" id="manSupLoc" placeholder="@ (m)" >
              <button class="btn-sec icon-btn" id="addManSup">＋</button>
            </div>
            <ul id="manSupList"></ul>
            <hr style="border:0;border-top:1px solid #e2e8f0;margin:0">
            
            <div class="row">
              <select id="manLoadType" onchange="toggleLoadInput('man')" style="flex:1">
                <option value="Point">Point Load</option>
                <option value="Distributed">Distributed</option>
              </select>
              
              <input type="number" id="manLoadMag" placeholder="N" >
              
              <input type="number" id="manLoadStart" placeholder="Start (m)" >
              
              <input type="number" id="manLoadEnd" placeholder="End (m)" style="display:none;">
              
              <button class="btn-sec icon-btn" id="addManLoad">＋</button>
            </div>
            <ul id="manLoadList"></ul>
          </div>

          <button class="btn-primary" id="runAnalysisBtn">Run Analysis ➤</button>
        </div>

        <div class="stack">
          
<div class="card pad">
  <h3 class="muted">Structural Model Visual</h3>
  <div style="position:relative;height:180px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;">
    <svg id="beamVisual" width="100%" height="100%"></svg>
  </div>
</div>

<div class="card pad">
            <h3 class="muted">Shear Force Diagram</h3>
            <div class="chart-box"><canvas id="chartShear"></canvas></div>
          </div>
          <div class="card pad">
            <h3 class="muted">Bending Moment Diagram</h3>
            <div class="chart-box"><canvas id="chartMoment"></canvas></div>
          </div>
          <div class="card pad">
            <h3 class="muted">Deflection Diagram</h3>
            <div class="chart-box"><canvas id="chartDeflect"></canvas></div>
          </div>

<div class="card pad" id="analysisSummary" style="margin-top:10px;">
  <h3 class="muted">Structural Performance Summary</h3>
  <div id="summaryContent" style="font-size:0.9rem; line-height:1.4;">
    Run analysis to see safety indicators and critical response values.
  </div>
</div>

        </div>
      </div>
    </div>

    <div id="compare" class="tab-content">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h2>Comparator Engine</h2>
        <span id="compareStatus" class="badge">Ready</span>
      </div>

      <div class="grid-2">
        <div class="stack">
          
          <div class="card pad stack">
            <h3>1. Design Requirements</h3>
            <div class="grid-2">
              <div>
                
<div class="label-row">
<label>Span Length (m)</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Required span length in meters (m).</div>
</div>
</div>

                <input type="number" id="compLength" value="5.0">
              </div>
              <div>
                
<div class="label-row">
<label>Environment</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Operating condition used for suitability filtering.</div>
</div>
</div>

                <select id="compEnv">
                  <option value="" disabled selected>Select...</option>
                  <option value="Indoor">Indoor</option>
                  <option value="Outdoor">Outdoor</option>
                  <option value="Marine">Marine</option>
                  <option value="Seismic">Seismic</option>
                </select>
              </div>
            </div>

            <label style="margin-top:6px">External Loads</label>
            <div class="row">
              <select id="compLoadType" onchange="toggleLoadInput('comp')" style="flex:1">
