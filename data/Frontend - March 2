<script>
let lastAnalysisResult = null;


function handleChat() {
  const input = document.getElementById("chatInput");
  const msg = input.value.trim();
  if (!msg) return;

  const chat = document.getElementById("chatMessages");
  chat.innerHTML += `<div><strong>You:</strong> ${msg}</div>`;

  let response = "Run an analysis first so I can help.";

  if (lastAnalysisResult) {
    const sf = lastAnalysisResult.max_moment ? lastAnalysisResult.max_moment : 0;
    const defl = lastAnalysisResult.max_deflection || 0;

    if (msg.toLowerCase().includes("deflection")) {
      response = defl > 0.02
        ? "Deflection appears high. Consider increasing I (moment of inertia)."
        : "Deflection is within reasonable limits.";
    } else if (msg.toLowerCase().includes("safe")) {
      response = "Safety depends on yield stress and moment. Check safety factor in comparator mode.";
    } else {
      response = "Try asking about deflection or safety factor.";
    }
  }

  chat.innerHTML += `<div style="margin-top:4px;"><strong>AI:</strong> ${response}</div>`;
  chat.scrollTop = chat.scrollHeight;
  input.value = "";
}

// Hook into analysis result
const originalRenderCharts = renderCharts;
renderCharts = function(data) {
  lastAnalysisResult = data;
  originalRenderCharts(data);
  renderBeamVisual();
};
</script>


