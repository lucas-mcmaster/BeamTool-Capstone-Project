<script>
function updateSummary(data) {
  const maxShear = Math.max(...data.shear.map(v => Math.abs(v)));
  const maxMoment = Math.max(...data.moment.map(v => Math.abs(v)));
  const maxDeflection = Math.max(...data.deflection.map(v => Math.abs(v)));

  let interpretation = "";

  if (maxDeflection > 0.02) {
    interpretation += "Deflection is relatively high. Consider increasing stiffness (higher I or E).<br>";
  } else {
    interpretation += "Deflection is within typical serviceability limits.<br>";
  }

  if (maxMoment > 0) {
    interpretation += "Peak bending moment indicates the critical region near maximum curvature.<br>";
  }

  if (maxShear > 0) {
    interpretation += "Maximum shear likely occurs near supports.<br>";
  }

  document.getElementById("summaryContent").innerHTML = `
    <strong>Max Shear:</strong> ${maxShear.toFixed(2)} N<br>
    <strong>Max Moment:</strong> ${maxMoment.toFixed(2)} Nm<br>
    <strong>Max Deflection:</strong> ${(maxDeflection * 1000).toFixed(2)} mm<br><br>
    <strong>Interpretation:</strong><br>
    ${interpretation}
  `;
}

// Hook into existing renderCharts
const originalRenderCharts2 = renderCharts;
renderCharts = function(data) {
  originalRenderCharts2(data);
  updateSummary(data);
};
</script>


<script>
let designHistory = JSON.parse(localStorage.getItem('beamHistory') || "[]");

function saveToHistory(entry) {
  designHistory.unshift(entry);
  localStorage.setItem('beamHistory', JSON.stringify(designHistory));
  renderHistory();
}

function renderHistory() {
  const container = document.getElementById("historyList");
  if (!designHistory.length) {
    container.innerHTML = "No saved designs yet.";
    return;
  }
  container.innerHTML = designHistory.map((h,i) => `
    <div style="border-bottom:1px solid #e2e8f0;padding:6px 0;">
      <strong>Design ${i+1}</strong><br>
      Length: ${h.length} m<br>
      Max Deflection: ${(h.deflection*1000).toFixed(2)} mm
    </div>
  `).join("");
}

function loadDatabase() {
  fetch("Beam Data - Sheet3.csv")
    .then(res => res.text())
    .then(text => {
      const rows = text.split("\n").map(r => r.split(","));
      const table = document.getElementById("databaseTable");
      table.innerHTML = rows.map((row,i) => `
        <tr style="background:${i===0?'#f1f5f9':'white'}">
          ${row.map(cell => `<td style="border:1px solid #e2e8f0;padding:4px;">${cell}</td>`).join("")}
        </tr>
      `).join("");
    })
    .catch(err => console.error(err));
}

// Hook into analysis summary saving
const originalUpdateSummary = updateSummary;
updateSummary = function(data) {
  originalUpdateSummary(data);
  saveToHistory({
    length: getVal('manLength'),
    deflection: Math.max(...data.deflection.map(v => Math.abs(v)))
  });
};

document.addEventListener("DOMContentLoaded", function() {
  renderHistory();
  loadDatabase();
});
</script>


<script>

function renderBeamVisualDetailed(data=null) {
  const svg = document.getElementById("beamVisual");
  if (!svg) return;

  svg.innerHTML = "";

  const width = svg.clientWidth;
  const height = svg.clientHeight;

  const beamY = height * 0.55;
  const beamLength = width * 0.9;
  const offsetX = width * 0.05;

  const L = getVal('manLength') || 1;

  // ---- Beam body ----
  const beam = document.createElementNS("http://www.w3.org/2000/svg", "rect");
  beam.setAttribute("x", offsetX);
  beam.setAttribute("y", beamY - 8);
  beam.setAttribute("width", beamLength);
  beam.setAttribute("height", 16);
  beam.setAttribute("fill", "#2563eb");
  beam.setAttribute("rx", "4");
  svg.appendChild(beam);

  // ---- Supports ----
  manualSupports.forEach(s => {
    const x = offsetX + (s.loc / L) * beamLength;

    if (s.type === "pin" || s.type === "roller") {
      const tri = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
      tri.setAttribute("points", `${x-12},${beamY+12} ${x+12},${beamY+12} ${x},${beamY+32}`);
      tri.setAttribute("fill", "#111827");
      svg.appendChild(tri);
    }

    if (s.type === "fixed") {
      const wall = document.createElementNS("http://www.w3.org/2000/svg", "rect");
      wall.setAttribute("x", x - 5);
      wall.setAttribute("y", beamY - 30);
      wall.setAttribute("width", 10);
      wall.setAttribute("height", 60);
      wall.setAttribute("fill", "#111827");
      svg.appendChild(wall);
    }
  });

  // ---- Loads ----
  manualLoads.forEach(l => {
    const xStart = offsetX + (l.a / L) * beamLength;

    if (l.type === "point") {
      const arrow = document.createElementNS("http://www.w3.org/2000/svg", "line");
      arrow.setAttribute("x1", xStart);
      arrow.setAttribute("x2", xStart);
      arrow.setAttribute("y1", beamY - 50);
      arrow.setAttribute("y2", beamY - 8);
      arrow.setAttribute("stroke", "#dc2626");
      arrow.setAttribute("stroke-width", "3");
      svg.appendChild(arrow);

      const head = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
      head.setAttribute("points", `${xStart-6},${beamY-8} ${xStart+6},${beamY-8} ${xStart},${beamY+4}`);
      head.setAttribute("fill", "#dc2626");
      svg.appendChild(head);
    }

    if (l.type === "distributed" && l.b !== null) {
      const xEnd = offsetX + (l.b / L) * beamLength;

      for (let x = xStart; x <= xEnd; x += 20) {
        const arrow = document.createElementNS("http://www.w3.org/2000/svg", "line");
        arrow.setAttribute("x1", x);
        arrow.setAttribute("x2", x);
        arrow.setAttribute("y1", beamY - 45);
        arrow.setAttribute("y2", beamY - 8);
        arrow.setAttribute("stroke", "#ef4444");
        arrow.setAttribute("stroke-width", "2");
        svg.appendChild(arrow);
      }

      const distLine = document.createElementNS("http://www.w3.org/2000/svg", "line");
      distLine.setAttribute("x1", xStart);
      distLine.setAttribute("x2", xEnd);
      distLine.setAttribute("y1", beamY - 45);
      distLine.setAttribute("y2", beamY - 45);
      distLine.setAttribute("stroke", "#ef4444");
      distLine.setAttribute("stroke-width", "2");
      svg.appendChild(distLine);
    }
  });

  // ---- Deflected Shape (if analysis ran) ----
  if (data && data.deflection) {
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    let d = "";
    data.x.forEach((xVal, i) => {
      const x = offsetX + (xVal / L) * beamLength;
      const y = beamY + data.deflection[i] * 200; // scaled visually
      d += i === 0 ? `M ${x} ${y}` : ` L ${x} ${y}`;
    });
    path.setAttribute("d", d);
    path.setAttribute("stroke", "#16a34a");
    path.setAttribute("stroke-width", "2");
    path.setAttribute("fill", "none");
    svg.appendChild(path);
  }
}

// Hook into analysis
const originalRenderCharts3 = renderCharts;
renderCharts = function(data) {
  originalRenderCharts3(data);
  renderBeamVisualDetailed(data);
};

</script>

