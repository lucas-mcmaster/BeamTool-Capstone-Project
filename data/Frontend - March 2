            <div class="grid-2">
              <div>
                
<div class="label-row">
<label>Max Cost ($)</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Maximum allowable total beam cost in dollars ($).</div>
</div>
</div>

                <input type="number" id="optCost" placeholder="Budget">
              </div>
              <div>
                
<div class="label-row">
<label>Material Pref</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Preferred material type (optional).</div>
</div>
</div>

                <select id="optMaterial">
                  <option value="">Any</option>
                  <option value="Steel">Steel</option>
                  <option value="Concrete">Concrete</option>
                  <option value="Wood">Wood</option>
                </select>
              </div>
              <div>
                
<div class="label-row">
<label>Target Depth (m)</label>
<div class="info-icon">
<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a1 1 0 110 2 1 1 0 010-2zm-1 4h2v6h-2z"/></svg>
<div class="tooltip">Desired beam depth in meters (m).</div>
</div>
</div>

                <input type="number" id="optDepth" placeholder="e.g. 0.4">
              </div>
            </div>
          </div>

          <button class="btn-primary" id="runCompareBtn">Find Optimal Design ➤</button>
        </div>

        <div class="stack" id="compareResults">
          <div class="card pad" style="display:flex;align-items:center;justify-content:center;height:200px;color:var(--muted)">
            Results will appear here...
          </div>
        </div>
      </div>
    </div>

  
<div id="history" class="tab-content">
  <h2>Design History</h2>
  <div class="card pad">
    <div id="historyList">No saved designs yet.</div>
  </div>
</div>

<div id="database" class="tab-content">
  <h2>Beam Database</h2>
  <div class="card pad" style="max-height:400px; overflow:auto;">
    <table id="databaseTable" style="width:100%; border-collapse:collapse; font-size:0.85rem;"></table>
  </div>
</div>

</main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    // --- Global State ---
    let manualLoads = [];
    let manualSupports = [];
    let compareLoads = [];
    let compareSupports = [];
    let charts = {}; 

    // --- Helpers ---
    function getVal(id) {
      const el = document.getElementById(id);
      return el ? (parseFloat(el.value) || 0) : 0;
    }
    function getText(id) {
      const el = document.getElementById(id);
      return el ? el.value : '';
    }

    // --- UI Logic: Tabs ---
    function showTab(id) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      document.querySelector(`button[onclick="showTab('${id}')"]`).classList.add('active');
    }

    // --- UI Logic: Toggle Load Inputs ---
    function toggleLoadInput(prefix) {
      const type = document.getElementById(prefix + 'LoadType').value;
      const endInput = document.getElementById(prefix + 'LoadEnd');
      const startInput = document.getElementById(prefix + 'LoadStart');
      
      if (type === 'Distributed') {
        endInput.style.display = 'block';
        startInput.placeholder = 'Start (m)';
      } else {
        endInput.style.display = 'none';
        startInput.placeholder = '@ (m)';
      }
    }

    // --- UI Logic: Add Load/Support to List ---
    function addToList(listName, type, details, displayStr) {
      const list = (listName === 'manualLoads') ? manualLoads :
                   (listName === 'manualSupports') ? manualSupports :
                   (listName === 'compareLoads') ? compareLoads : compareSupports;
      
      // Store data for Backend
      list.push({ type: type, ...details });

      // Update UI
      const ulId = (listName === 'manualLoads') ? 'manLoadList' :
                   (listName === 'manualSupports') ? 'manSupList' :
                   (listName === 'compareLoads') ? 'compLoadList' : 'compSupList';
      
      const li = document.createElement('li');
      li.innerHTML = `<span>${displayStr}</span> <button class="del-btn" onclick="removeItem('${listName}', ${list.length-1}, this)">×</button>`;
      document.getElementById(ulId).appendChild(li);
    }

    function removeItem(listName, index, btn) {
      const list = (listName === 'manualLoads') ? manualLoads :
                   (listName === 'manualSupports') ? manualSupports :
                   (listName === 'compareLoads') ? compareLoads : compareSupports;
      list[index] = null; 
      btn.parentElement.style.display = 'none';
    }

    function getCleanList(list) {
      return list.filter(item => item !== null);
    }

    // --- Manual Tab Events ---
    document.getElementById('addManLoad').addEventListener('click', () => {
      const typeRaw = document.getElementById('manLoadType').value; 
      const mag = getVal('manLoadMag');
      const start = getVal('manLoadStart');
      
      // Handle Distributed Logic
      let b = null;
      let displayStr = `${typeRaw}: ${mag}N @ ${start}m`;
      
      if (typeRaw === 'Distributed') {
        b = getVal('manLoadEnd');
        if (b <= start) { alert("End must be greater than Start"); return; }
        displayStr = `Distributed: ${mag}N/m from ${start}m to ${b}m`;
      }

      const type = (typeRaw === 'Point') ? 'point' : 'distributed';
      addToList('manualLoads', type, { mag: mag, a: start, b: b }, displayStr);
    });

    document.getElementById('addManSup').addEventListener('click', () => {
      const typeRaw = document.getElementById('manSupType').value; 
      const loc = getVal('manSupLoc');
      addToList('manualSupports', typeRaw.toLowerCase(), { loc: loc }, `${typeRaw} Support @ ${loc}m`);
    });

    // --- Compare Tab Events ---
    document.getElementById('addCompLoad').addEventListener('click', () => {
      const typeRaw = document.getElementById('compLoadType').value;
      const mag = getVal('compLoadMag');
      const start = getVal('compLoadStart');
      
      let b = null;
      let displayStr = `${typeRaw}: ${mag}N @ ${start}m`;

      if (typeRaw === 'Distributed') {
        b = getVal('compLoadEnd');
        if (b <= start) { alert("End must be greater than Start"); return; }
        displayStr = `Distributed: ${mag}N/m from ${start}m to ${b}m`;
      }

      const type = (typeRaw === 'Point') ? 'point' : 'distributed';
      addToList('compareLoads', type, { mag: mag, a: start, b: b }, displayStr);
    });

    document.getElementById('addCompSup').addEventListener('click', () => {
      const typeRaw = document.getElementById('compSupType').value;
      const loc = getVal('compSupLoc');
      addToList('compareSupports', typeRaw.toLowerCase(), { loc: loc }, `${typeRaw} Support @ ${loc}m`);
    });

    // --- API CALL: MANUAL ANALYSIS ---
    document.getElementById('runAnalysisBtn').addEventListener('click', async () => {
      const payload = {
        length: getVal('manLength'),
        E: getVal('manE') * 1e9, 
        I: getVal('manI') * 1e-6, 
        beam_weight: getVal('manWeight'),
        loads: getCleanList(manualLoads),
        supports: getCleanList(manualSupports)
      };

      const statusEl = document.getElementById('analysisStatus');
      statusEl.textContent = "Processing...";

      try {
        const response = await fetch('/api/analyse', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        
        if (data.error) {
          statusEl.textContent = "Error: " + data.error;
        } else {
          statusEl.textContent = `Success! Max Deflection: ${(data.max_deflection*1000).toFixed(2)} mm`;
          renderCharts(data);
        }
      } catch (err) {
        console.error(err);
        statusEl.textContent = "Network Error.";
      }
    });

    // --- API CALL: COMPARATOR ---
    document.getElementById('runCompareBtn').addEventListener('click', async () => {
      const payload = {
        length: getVal('compLength'),
        environment: document.getElementById('compEnv').value,
        loads: getCleanList(compareLoads),
        supports: getCleanList(compareSupports),
        desired_material: getText('optMaterial'),
        max_cost: getVal('optCost'),
        desired_depth: getVal('optDepth')
      };

      if (!payload.environment) {
        alert("Please select an environment.");
        return;
      }

      const statusEl = document.getElementById('compareStatus');
      statusEl.textContent = "Finding optimal design...";

      try {
        const response = await fetch('/api/recommend', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();

        if (data.error) {
          statusEl.textContent = data.error;
        } else {
          statusEl.textContent = "Design Found!";
          renderRecommendation(data);
        }
      } catch (err) {
        console.error(err);
        statusEl.textContent = "Network Error.";
      }
    });

    // --- Visualization: Charts ---
    function renderCharts(data) {
      const ctxShear = document.getElementById('chartShear');
      const ctxMoment = document.getElementById('chartMoment');
      const ctxDeflect = document.getElementById('chartDeflect');

      if(!ctxShear) return;

      const createChart = (ctx, label, xData, yData, color) => {
        if (charts[ctx.id]) charts[ctx.id].destroy(); 
        charts[ctx.id] = new Chart(ctx, {
          type: 'line',
          data: {
            labels: xData.map(v => v.toFixed(2)),
            datasets: [{
              label: label,
              data: yData,
              borderColor: color,
              fill: true,
              backgroundColor: color + '33',
              pointRadius: 0,
              borderWidth: 2
            }]
          },
          options: { 
            responsive: true, 
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { display: false }, title: { display: true, text: label } },
            scales: { x: { display: true }, y: { display: true } }
          }
        });
      };

      createChart(ctxShear, 'Shear Force (N)', data.x, data.shear, '#e74c3c');
      createChart(ctxMoment, 'Bending Moment (Nm)', data.x, data.moment, '#2980b9');
      createChart(ctxDeflect, 'Deflection (m)', data.x, data.deflection, '#27ae60');
    }

    // --- Visualization: Recommendations ---
    function renderRecommendation(data) {
      const rec = data.recommended;
      const res = data.analysis_results;

      const html = `
        <div class="card pad stack" style="border: 2px solid var(--ok);">
          <div class="row" style="justify-content:space-between">
              <div>
                <strong style="font-size:1.1rem">${rec.Designation}</strong>
                <div class="muted">${rec.material} • ${rec.type} Beam</div>
              </div>
              <span class="badge" style="background:#dcfce7;color:#166534;font-size:1rem">Score: ${data.score.toFixed(2)}</span>
          </div>
          
          <div style="background:#f8fafc; padding:12px; border-radius:8px; display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:0.9rem">
              <div>Total Cost: <strong>$${res.total_cost.toFixed(2)}</strong></div>
              <div>Safety Factor: <strong>${res.safety_factor.toFixed(2)}</strong></div>
              <div>Max Deflection: <strong>${(res.max_deflection*1000).toFixed(2)} mm</strong></div>
              <div>Beam Depth: <strong>${rec.Depth} m</strong></div>
          </div>
          <div class="muted" style="font-size:0.8rem">
            *Includes self-weight and environmental constraints.
          </div>
        </div>
        
        <h4 class="muted" style="margin-top:6px">Other Candidates</h4>
        ${data.matches.slice(1).map(m => `
          <div class="card pad row" style="justify-content:space-between; opacity:0.8">
            <div><strong>${m.Designation}</strong> <span class="muted">(${m.material})</span></div>
          </div>
        `).join('')}
      `;
      
      const container = document.getElementById('compareResults');
      container.innerHTML = html;
    }
  </script>

<div id="aiChatbox" style="position:fixed;bottom:20px;right:20px;width:360px;height:460px;background:white;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.15);border:1px solid #e2e8f0;display:flex;flex-direction:column;overflow:hidden;z-index:9999;">
